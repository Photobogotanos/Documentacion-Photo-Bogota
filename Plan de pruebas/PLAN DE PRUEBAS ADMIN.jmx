<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="PLAN DE PRUEBAS ADMIN PHOTOBOGOTA" enabled="true">
      <stringProp name="TestPlan.comments">Pruebas de carga por fases para el modulo de Administrador. Fase 1 Calentamiento, Fase 2 Carga Media, Fase 3 Carga Objetivo, Fase 4 Estrés. Tests de solo lectura marcados con - ESTRES.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments">
          <elementProp name="usuario_id" elementType="Argument">
            <stringProp name="Argument.name">usuario_id</stringProp>
            <stringProp name="Argument.value">REEMPLAZAR</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="eliminacion_id" elementType="Argument">
            <stringProp name="Argument.name">eliminacion_id</stringProp>
            <stringProp name="Argument.value">REEMPLAZAR</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="palabra_id" elementType="Argument">
            <stringProp name="Argument.name">palabra_id</stringProp>
            <stringProp name="Argument.value">REEMPLAZAR</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="apelacion_id" elementType="Argument">
            <stringProp name="Argument.name">apelacion_id</stringProp>
            <stringProp name="Argument.value">REEMPLAZAR</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="mantenimiento_id" elementType="Argument">
            <stringProp name="Argument.name">mantenimiento_id</stringProp>
            <stringProp name="Argument.value">REEMPLAZAR</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="reporte_id" elementType="Argument">
            <stringProp name="Argument.name">reporte_id</stringProp>
            <stringProp name="Argument.value">REEMPLAZAR</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="aspirante_id" elementType="Argument">
            <stringProp name="Argument.name">aspirante_id</stringProp>
            <stringProp name="Argument.value">REEMPLAZAR</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
